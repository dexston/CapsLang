# Auto-detect text files and normalize line endings
* text=auto

# Windows source files, markup, scripts, and localization resources
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.manifest text eol=crlf
*.iss text eol=crlf
*.strings text eol=crlf
*.resx text eol=crlf
*.ps1 text eol=crlf
*.md text eol=crlf

# GitHub Actions workflows
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.ico binary
*.cer binary
*.pfx binary
