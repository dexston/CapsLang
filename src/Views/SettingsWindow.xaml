<Window x:Class="CapsLang.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CapsLang"
        Title="{Binding WindowTitle}"
        Width="530"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ResWindowBg}"
        Foreground="{DynamicResource ResTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CapsLang;component/src/Views/Icons.xaml" />
                <ResourceDictionary Source="/CapsLang;component/src/Views/FluentStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Reusable Rule Section Body (Empty State + Expandable 1..5 Item List) -->
            <DataTemplate x:Key="RuleSectionBodyTemplate">
                <Border Background="{DynamicResource ResInputBg}"
                        BorderBrush="{DynamicResource ResInputBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4">
                    <Grid>
                        <TextBlock Text="{Binding EmptyHint}"
                                   Foreground="{DynamicResource ResTextMuted}"
                                   FontSize="12"
                                   Margin="8,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer MaxHeight="{x:Static local:AppConstants.MaxRuleListHeight}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="{x:Static local:AppConstants.RuleItemHeight}"
                                                CornerRadius="4"
                                                Margin="0,1"
                                                Padding="8,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ResBtnHoverBg}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding}"
                                                           Foreground="{DynamicResource ResTextPrimary}"
                                                           FontSize="13"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding}" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource FluentDeleteButton}"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Center">
                                                    <Path Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="{StaticResource IconDismiss}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="8,4,8,8">

        <!-- 1. Top Card: App Header & About, Action Buttons, and Two Toggle Switches -->
        <Border Style="{StaticResource FluentCardBorder}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <!-- Header: Left Logo 96x96, Center Info, Right Buttons 96x96 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Interactive Vector Logo (96x96) -->
                    <Grid Grid.Column="0"
                          Width="96"
                          Height="96"
                          Cursor="Hand">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleEasterEggThemeCommand}" />
                        </Grid.InputBindings>

                        <!-- Background Squircle & Border (96x96) -->
                        <Border Width="96"
                                Height="96"
                                CornerRadius="23"
                                Background="{DynamicResource ResLogoBg}"
                                BorderBrush="{DynamicResource ResLogoBorder}"
                                BorderThickness="4" />

                        <!-- Vector CL aligned exactly on 96x96 Canvas -->
                        <Canvas Width="96" Height="96" ClipToBounds="True">
                            <!-- Letter C: Left 17.4, Top 24, Width 27, Height 48 -->
                            <Path Fill="White" Data="{StaticResource LogoLetterC}" />
                            <!-- Letter L: Left 51.6, Top 24, Width 27, Height 48 (Stem 12, Foot 27) -->
                            <Path Fill="White" Data="{StaticResource LogoLetterL}" />
                        </Canvas>
                    </Grid>

                    <!-- Center: Text Info (Vertically centered) -->
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <!-- Title + Version Pill Badge -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppTitle}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ResTextPrimary}"
                                       VerticalAlignment="Center" />
                            <Border Margin="8,4,0,0"
                                    Padding="7,2,7,2"
                                    CornerRadius="9"
                                    Background="{DynamicResource ResBadgeBg}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding AppVersionTooltip}">
                                <TextBlock Text="{Binding AppVersionText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ResTextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Text="{Binding AppDescriptionText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ResTextSecondary}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="16" />

                        <!-- Copyright Line -->
                        <TextBlock Text="{Binding AppCopyrightText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ResTextMuted}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Right: Buttons Block (96x96: 44 + 8 + 44 Grid) -->
                    <Grid Grid.Column="2" Width="96" Height="96" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <!-- [ 1 ]: Source code -->
                        <Button Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource FluentHeaderSquareButton}"
                                Command="{Binding OpenSourceCodeCommand}"
                                ToolTip="{Binding SourceCodeTooltip}">
                            <Viewbox Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconCode}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- [ 2 ]: Share -->
                        <Button x:Name="BtnShare"
                                Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource FluentHeaderSquareButton}"
                                Command="{Binding ShareCommand}"
                                ToolTip="{Binding ShareTooltip}">
                            <Viewbox Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Canvas.Left="-1" Canvas.Top="0.5"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconShare}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- [ 3 ]: Language (Globe) -->
                        <Button Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource FluentHeaderSquareButton}"
                                ToolTip="{Binding LanguageTooltip}"
                                Click="OnLanguageButtonClick">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource FluentContextMenu}"
                                             ItemsSource="{Binding Languages}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource FluentMenuItem}">
                                            <Setter Property="Header" Value="{Binding Title}" />
                                            <Setter Property="IsChecked" Value="{Binding IsSelected}" />
                                            <Setter Property="Command" Value="{Binding SelectCommand}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Viewbox Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconGlobe}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- [ 4 ]: Backup Menu (Export / Import) -->
                        <Button Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource FluentHeaderSquareButton}"
                                ToolTip="{Binding BackupTooltip}"
                                Click="OnBackupButtonClick">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource FluentContextMenu}">
                                    <MenuItem Style="{StaticResource FluentActionMenuItem}"
                                              Header="{Binding ExportMenuHeader}"
                                              Command="{Binding ExportCommand}" />
                                    <MenuItem Style="{StaticResource FluentActionMenuItem}"
                                              Header="{Binding ImportMenuHeader}"
                                              Command="{Binding ImportCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Viewbox Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconSave}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Thin Divider before Toggles -->
                <Border x:Name="HeaderDivider" Height="1" Background="{DynamicResource ResCardBorder}" Margin="0,0,0,12" />

                <Popup x:Name="ShareCopiedPopup"
                       AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=HeaderDivider}"
                       Placement="Center"
                       VerticalOffset="-3"
                       StaysOpen="False"
                       Focusable="False"
                       PopupAnimation="Fade"
                       MouseDown="OnSharePopupMouseDown">
                    <Grid Margin="8">
                        <Border Background="{DynamicResource ResCardBg}"
                                BorderBrush="{DynamicResource ResCardBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,5,14,5"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.25"
                                                  Color="#000000" />
                            </Border.Effect>
                            <TextBlock Text="{Binding ShareCopiedText}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource ResTextPrimary}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Popup>

                <!-- Toggle 1: Enable / Disable Utility -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ActiveTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ResTextPrimary}" />
                        <TextBlock Text="{Binding ActiveDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ResTextSecondary}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource FluentToggleSwitch}"
                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- Thin Divider -->
                <Border Height="1" Background="{DynamicResource ResCardBorder}" Margin="0,0,0,12" />

                <!-- Toggle 2: Windows Startup -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding StartupTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ResTextPrimary}" />
                        <TextBlock Text="{Binding StartupDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ResTextSecondary}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource FluentToggleSwitch}"
                              IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Rule Section 1: Processes -->
        <Border Style="{StaticResource FluentCardBorder}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProcessesSection.Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ResTextPrimary}"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="9"
                                    Padding="7,1"
                                    Margin="8,1,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ResBadgeBg}">
                                <TextBlock Text="{Binding ProcessesSection.CounterText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ResTextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ProcessesSection.Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ResTextSecondary}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource FluentAccentButton}"
                            Command="{Binding AddProcessCommand}"
                            VerticalAlignment="Center">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource IconAdd}" />
                    </Button>
                </Grid>
                <ContentControl Content="{Binding ProcessesSection}"
                                ContentTemplate="{StaticResource RuleSectionBodyTemplate}" />
            </StackPanel>
        </Border>

        <!-- 3. Rule Section 2: Folders -->
        <Border Style="{StaticResource FluentCardBorder}" Padding="12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FoldersSection.Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ResTextPrimary}"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="9"
                                    Padding="7,1"
                                    Margin="8,1,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ResBadgeBg}">
                                <TextBlock Text="{Binding FoldersSection.CounterText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ResTextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding FoldersSection.Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ResTextSecondary}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource FluentAccentButton}"
                            Command="{Binding AddFolderCommand}"
                            VerticalAlignment="Center">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource IconAdd}" />
                    </Button>
                </Grid>
                <ContentControl Content="{Binding FoldersSection}"
                                ContentTemplate="{StaticResource RuleSectionBodyTemplate}" />
            </StackPanel>
        </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
